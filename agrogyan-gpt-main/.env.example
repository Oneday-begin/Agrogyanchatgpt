# Local default; do not paste secrets into chat or commit .env.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=embeddinggemma
# For openai/gemini set LLM_PROVIDER, LLM_MODEL and the matching key.
LLM_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_NAME=Administrator
COOKIE_SECURE=false
# Supported provider variables are documented in backend/main.py send_otp_via_provider.
OTP_PROVIDER=mock
DATA_GOV_API_KEY=
AGMARKNET_RESOURCE_ID=

# Dedicated local translation model (ollama pull translategemma:4b)
TRANSLATION_MODEL=translategemma:4b

# Fall back to keyword search promptly if embeddings are busy or unavailable.
EMBEDDING_QUERY_TIMEOUT_SECONDS=5
RAG_MAX_CONTEXT_CHUNKS=5

# Free hosted demo only; keep false for the existing phone-verification flow.
BASIC_REGISTRATION=false
# Hosted provider: LLM_PROVIDER=groq, TRANSLATION_PROVIDER=groq
GROQ_API_KEY=
# Disable local semantic model calls on low-memory hosts; BM25 stays active.
SEMANTIC_ENABLED=true
